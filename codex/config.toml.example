# Whatsify MCP server for OpenAI Codex CLI.
#
# Streamable-HTTP MCP servers with OAuth are supported natively in
# current Codex CLI. Append this block to ~/.codex/config.toml (or your
# project's .codex/config.toml), then run:
#
#   codex mcp login whatsify
#
# That opens your browser to Whatsify's login/consent screen — sign in,
# approve the permissions, and Codex stores the resulting credentials
# itself. No token to create or paste.

[mcp_servers.whatsify]
url = "https://api.whatsify.me/mcp"
